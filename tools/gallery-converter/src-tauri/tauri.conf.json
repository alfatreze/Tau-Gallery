{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tau Gallery Converter",
  "version": "0.3.0",
  "identifier": "dev.tau.gallery-converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Tau Gallery Converter", "width": 660, "height": 720, "minWidth": 520, "minHeight": 620, "dragDropEnabled": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "alfatreze",
    "category": "Photography",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
